# ZeroMQ endpoint of the mudri simulation service.
# For a remote server, use: tcp://<server-ip>:5556
# For an SSH tunnel, keep this as tcp://127.0.0.1:5556.
ARTEMIS_MANUAL_TARGET=tcp://127.0.0.1:5556

# ZeroMQ PUB state stream from artemis-mudri --viewer-state-bind.
# This drives the canvas animation, even when another controller owns 5556.
ARTEMIS_MANUAL_VIEWER_STATE_CONNECT=tcp://127.0.0.1:5555

# Local manual console backend bind address.
ARTEMIS_MANUAL_WEB_HOST=127.0.0.1
ARTEMIS_MANUAL_WEB_PORT=8765

# Local Vite dev server port.
ARTEMIS_MANUAL_VITE_PORT=5173

# Driving behavior.
ARTEMIS_MANUAL_MAX_SPEED=20
ARTEMIS_MANUAL_ACCEL=80
ARTEMIS_MANUAL_CONTROL_PERIOD=0.02
ARTEMIS_MANUAL_MAX_TIME=2400

# Browser keyboard controls.
ARTEMIS_MANUAL_LEFT_KEY=j
ARTEMIS_MANUAL_RIGHT_KEY=l
